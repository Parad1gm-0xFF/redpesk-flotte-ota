# --- Artefacts de build RPM / redpesk ---
*.rpm
dist/
.rpmbuild/
build/
tmp/

# --- Clés privées et secrets : JAMAIS commités ---
# La clé privée mender de chaque board est générée / importée localement
# (voir scripts/). Elle ne doit jamais apparaître dans git.
*.pem
*.key
keys/
secrets/

# --- Config locale (URL de factory, tokens) ---
.config.local
.devices/

# --- Outils téléchargés à la volée ---
/tools/

# --- Éditeurs / OS ---
*.swp
*~
.DS_Store

# --- Images disques QEMU / VM (lourdes, jamais commitées ni synchronisées) ---
# L'image redpesk (~5 Go) vit HORS Nextcloud, dans $HOME/vm-images/ (voir
# docs/simulate-fleet.md), pour ne pas saturer la synchro nextcloud.
*.img
*.raw
vm-fleet/OVMF_VARS_*.fd
vm-fleet/Redpesk-OS.img
# Config locale (ne pas committer)
config/.env
