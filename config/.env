# Configuration locale (JAMAIS commitée : copier vers config/.env et renseigner)
# Copie : cp config/.env.example config/.env

# URL de la redpesk factory (Community par défaut)
FACTORY_URL=https://community-app.redpesk.bzh

# Utilisateur redpesk (login du compte factory)
RP_USER=Parad1gm-0xFF

# Nom du projet dans la factory (créé au provisionnement si absent)
RP_PROJECT=redpesk-flotte-ota

# Nom du model board (== device type Mender côté cible)
MODEL_BOARD=rpi3b-flotte

# Nom du produit RPM embarqué dans l'image (package de configuration)
RP_PACKAGE=redpesk-flotte-ota

# Mot de passe de l'image redpesk OS (SSH root sur cible, à changer dès le flash)
TARGET_ROOT_PASSWORD=redpesk

# Nom de la board active pour status/check (optionnel)
BOARD_NAME=${BOARD_NAME:-rpi3b-01}